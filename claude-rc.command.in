#!/bin/zsh
# Opens Claude Remote Control for @RC_DIR@ in a Terminal window.
# Double-click it, or let it run at login as a Login Item.
# Generated by install.sh from claude-rc.command.in - edit the template.
cd "@RC_DIR@" || exit 1

TOOLS="$HOME/.claude/tools"
CLAUDE="@CLAUDE_BIN@"
PYTHON="@PYTHON@"
# Each folder has its own status file and lock; the first folder's carry no
# tag (@RC_TAG@ is empty), as in the one-folder kit.
STATUS="$TOOLS/rc-last-exit@RC_TAG@"
LOCK="$TOOLS/rc-launch@RC_TAG@.lock"
PAUSE=${RC_PAUSE:-8}            # seconds a message stays readable before the window exits
START=$(date +%s)
mkdir -p "$TOOLS"

# Tell the sweep watchdog (limit-resume.py) why this run ended:
#   <end epoch> <auth|network|exit> <exit code> <seconds it ran>
finish() {
  print -r -- "$(date +%s) $1 $2 $(( $(date +%s) - START ))" > "$STATUS.tmp" \
    && mv "$STATUS.tmp" "$STATUS"
}

# Only one Remote Control server may serve a folder; a second is refused with a
# 409. This folder's server is the one named @RC_NAME@, or one started by hand
# here (its working directory is this folder); a server for another folder
# does not count. The same rule as the sweep watchdog's (rc_serving). Gotchas:
#   - pgrep does not see this process on macOS: "pgrep -f claude rc" reports
#     nothing while it is plainly running, so match on ps output instead.
#   - the pattern is anchored to the start of the command, or shell wrappers
#     that merely mention "claude rc" count as a false positive and we would
#     decline to start when nothing is actually running.
#   - ps does not quote arguments: the name runs up to the next " --".
RC_RE='^(/[^ ]*/)?claude (rc|remote-control)([ ]|$)'
serving_pid() {
  local row pid cmd
  for row in ${(f)"$(ps -Ao pid=,command=)"}; do
    read -r pid cmd <<< "$row"
    [[ $cmd =~ $RC_RE ]] || continue
    if [[ $cmd == *" --name @RC_NAME@"(| --*) ]] \
       || [[ "$(lsof -a -p $pid -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')" == "${PWD:A}" ]]; then
      print -r -- $pid
      return 0
    fi
  done
  return 1
}
if pid=$(serving_pid); then
  echo "Remote Control already serves @RC_DIR@ (pid $pid)."
  echo "Nothing to do - you can close this window."
  sleep $PAUSE
  exit 0
fi

# One launcher per folder at a time. The Login Item and the watchdog can both
# fire in the minutes after login; two starts would refresh the login token
# concurrently. (Launchers of different folders do start side by side.)
# A kernel lock, held for as long as this shell lives and released by the kernel
# however it dies - nothing to go stale, no pid to be recycled after a reboot.
# The watchdog probes the same lock before it launches.
zmodload zsh/system
[[ -d "$LOCK" ]] && rm -rf "$LOCK"      # a directory lock from the 2026-10-08 build
: >> "$LOCK"
if ! zsystem flock -t 1 -f LOCKFD "$LOCK" 2>/dev/null; then
  echo "Another launcher is already starting Remote Control."
  sleep $PAUSE
  exit 0
fi

# Ctrl-C, a closed window or a kill must still leave a status behind. zsh runs
# the trap once the foreground command has ended, then carries on below.
STOP=0
trap 'STOP=1' HUP INT TERM

# Do not start until the API answers quickly, three times in a row. The login
# token is single-use on refresh: if a refresh reaches the server but its reply
# is lost to a timeout, the stored token is dead and only `claude /login` brings
# it back. That is how the login was lost at 02:07 on 2026-10-07, seconds after
# boot. Gives up after ~5 minutes without ever touching the token.
echo "Waiting for a working connection to api.anthropic.com ..."
ok=0
for i in {1..${RC_GATE_TRIES:-40}}; do
  (( STOP )) && exit 130
  if curl -s -o /dev/null --max-time 3 https://api.anthropic.com/; then
    (( ++ok >= 3 )) && break
    sleep ${RC_GATE_OK_SLEEP:-2}
  else
    ok=0
    sleep ${RC_GATE_SLEEP:-5}
  fi
done
if (( ok < 3 )); then
  echo "The network is not ready. Not starting, so the login is not put at risk."
  echo "The watchdog starts Remote Control once the network is back."
  finish network 1
  sleep $PAUSE
  exit 1
fi

# Logged out: starting would only fail. Say so and let the watchdog alert.
if "$CLAUDE" auth status 2>/dev/null | grep -q '"loggedIn": *false'; then
  echo "Claude is not logged in. Run:  claude /login"
  finish auth 1
  sleep $PAUSE
  exit 1
fi

mkdir -p "$TOOLS/rc-debug"
# Prune debug logs older than 14 days so a hang leaves evidence without
# growing unbounded.
find "$TOOLS/rc-debug" -name '*.log' -mtime +14 -delete 2>/dev/null

DEBUG_LOG="$TOOLS/rc-debug/rc@RC_TAG@-$(date +%Y%m%dT%H%M%S).log"
echo "Starting Claude Remote Control in $(pwd) ..."
echo "Debug log: $DEBUG_LOG"
# Dead-man check for the sweep. launchd can hold the agent without a word
# (2026-11-20/21: no sweep for ~35 h), and a sweep that never runs cannot say
# so. Terminal, not launchd, started this shell, so while the server runs it
# asks the tool every 10 min; `deadman` alerts once per stall. zselect is a
# builtin sleep, so killing the loop leaves no child behind, and the loop ends
# by itself if this shell is killed outright.
# Once per machine, however many folders are served: `deadman` alerts on the
# second stale check in a row, and two launchers' checks seconds apart would
# make a sweep merely late after a wake look stalled. The loop that holds
# rc-deadman.lock asks; the others try for it at each turn and take over when
# its launcher ends.
zmodload zsh/zselect
: >> "$TOOLS/rc-deadman.lock"
( while zselect -t $(( ${RC_DEADMAN_EVERY:-600} * 100 )); kill -0 $$ 2>/dev/null; do
    (( DEADMAN_FD )) || zsystem flock -t 0 -f DEADMAN_FD "$TOOLS/rc-deadman.lock" || continue
    "$PYTHON" "$TOOLS/limit-resume.py" deadman
  done ) >/dev/null 2>&1 &
DEADMAN=$!

# Not exec'd: the shell stays to record how the server ended. Sessions it
# spawns (from the phone, claude.ai/code, scheduled tasks) start in auto mode,
# not manual: unattended work would otherwise stop at the first permission ask.
"$CLAUDE" remote-control --name "@RC_NAME@" --permission-mode auto --debug-file "$DEBUG_LOG"
code=$?
kill $DEADMAN 2>/dev/null
reason=exit
# Anchored to the server's own log line. The debug log also carries everything
# the sessions say, so the bare phrase turns up in ordinary conversation.
if grep -qE '^[^ ]+ \[DEBUG\] \[bridge:api\] Registration: Token refresh failed' "$DEBUG_LOG" 2>/dev/null; then
  reason=auth
  echo "The login could not be renewed. Run:  claude /login"
fi
finish $reason $code
exit $code
